+static int hex_nibble(int c)
+{
+    if (c >= '0' && c <= '9')
+        return c - '0';
+    if (c >= 'a' && c <= 'f')
+        return 10 + (c - 'a');
+    if (c >= 'A' && c <= 'F')
+        return 10 + (c - 'A');
+    return -1;
+}
+
+static int hex_to_bytes(const char *hex, unsigned char *out, size_t out_cap, size_t *out_len)
+{
+    size_t len;
+    if (!hex || !out)
+        return -1;
+    len = strlen(hex);
+    if ((len % 2) != 0)
+        return -1;
+    if ((len / 2) > out_cap)
+        return -1;
+    for (size_t i = 0; i < len / 2; i++) {
+        int hi = hex_nibble((unsigned char) hex[i * 2]);
+        int lo = hex_nibble((unsigned char) hex[i * 2 + 1]);
+        if (hi < 0 || lo < 0)
+            return -1;
+        out[i] = (unsigned char) ((hi << 4) | lo);
+    }
+    if (out_len)
+        *out_len = len / 2;
+    return 0;
+}
+
+static int bytes_to_hex(const unsigned char *in, size_t in_len, char *out, size_t out_cap)
+{
+    static const char hex[] = "0123456789abcdef";
+    if (!in || !out)
+        return -1;
+    if (out_cap < (in_len * 2 + 1))
+        return -1;
+    for (size_t i = 0; i < in_len; i++) {
+        out[i * 2] = hex[in[i] >> 4];
+        out[i * 2 + 1] = hex[in[i] & 0x0F];
+    }
+    out[in_len * 2] = '\0';
+    return 0;
+}
