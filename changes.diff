+static int recv_line(SOCKET sock, char *out, size_t cap)
+{
+    size_t used = 0;
+    if (!out || cap == 0)
+        return -1;
+
+    while (used < cap - 1) {
+        char c = 0;
+        int n = recv(sock, &c, 1, 0);
+        if (n <= 0)
+            break;
+        if (c == '\n')
+            break;
+        out[used++] = c;
+    }
+
+    out[used] = '\0';
+    if (used == 0)
+        return -1;
+    return 0;
+}
