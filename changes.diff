+                cfg.idProverBytes(),
+                cfg.idVerifierBytes(),
+                P256_M_COMPRESSED,
+                P256_N_COMPRESSED,
+                session.shareP,
+                shareV,
+                zOctets,
+                vOctets,
+                reg.w0);
