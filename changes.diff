+    p++;
+    end = strchr(p, '"');
+    if (!end)
+        return -1;
+    len = (size_t) (end - p);
+    if (len + 1 > cap)
+        return -1;
+    memcpy(out, p, len);
+    out[len] = '\0';
+    return 0;
