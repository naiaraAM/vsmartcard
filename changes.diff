+    int pad = 0;
+    if (len >= 1 && in[len - 1] == '=') pad++;
+    if (len >= 2 && in[len - 2] == '=') pad++;
+    size_t need = (len / 4) * 3;
+    if (out_cap < need)
+        return -1;
+    int n = EVP_DecodeBlock(out, (const unsigned char *) in, (int) len);
+    if (n < 0)
+        return -1;
+    n -= pad;
+    if (n < 0)
+        return -1;
+    if (out_len)
